# OPENAI_API_KEY: Required for server-side OpenAI API calls.
# Configure this value only as a server-side environment variable or secret.
OPENAI_API_KEY="MY_OPENAI_API_KEY"

# GOOGLE_DESKTOP_CLIENT_SECRET: Required only by the production server for the
# Electron system-browser OAuth code exchange. Never expose this to client builds.
GOOGLE_DESKTOP_CLIENT_SECRET=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
